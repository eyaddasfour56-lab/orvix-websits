# Public application URLs
NEXT_PUBLIC_SITE_URL=https://example.com
SITE_URL=https://example.com

# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key

# Admin security — required
ADMIN_PASSWORD=replace-with-strong-owner-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=
ADMIN_2FA_ENABLED=false
ADMIN_2FA_SECRET=replace-with-at-least-32-random-characters
ADMIN_2FA_EMAIL=

# Optional limited admin roles
ADMIN_MANAGER_PASSWORD=
ADMIN_MANAGER_2FA_EMAIL=
ADMIN_ORDERS_PASSWORD=
ADMIN_ORDERS_2FA_EMAIL=
ADMIN_OWNER_2FA_EMAIL=

# Scheduled jobs — required when enabling Vercel cron processing
CRON_SECRET=replace-with-at-least-32-random-characters

# Transactional email — optional; requires a verified sender domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# SMS and OTP — optional; keep feature flags false until the account is approved and funded
SENT_API_KEY=
SENT_DM_API_KEY=
SENT_TRACKING_SMS_ENABLED=false
SENT_CHECKOUT_SMS_ENABLED=false
SENT_ORDER_SMS_ENABLED=false
SENT_SUPPORT_TEMPLATE_ID=
SENT_SUPPORT_TEMPLATE_NAME=
TRACKING_OTP_SECRET=replace-with-at-least-32-random-characters
CHECKOUT_OTP_SECRET=replace-with-at-least-32-random-characters

# Bosta shipping — optional
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=

# AI assistance — optional
AI_GATEWAY_API_KEY=
AI_GATEWAY_CHAT_MODEL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Local load testing only
LOAD_TEST_BASE_URL=http://localhost:3000
LOAD_TEST_CONCURRENCY=4
LOAD_TEST_ROUNDS=3
